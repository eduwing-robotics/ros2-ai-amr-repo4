#!/usr/bin/env bash
set -eo pipefail
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-4}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_DIR"
PYTHON_BIN="${GLOBALCAM_PYTHON:-${ROBOT_FACE_PYTHON:-$PROJECT_DIR/.venv/bin/python}}"
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="python3"
fi
PYTHONPATH="$PROJECT_DIR:${PYTHONPATH:-}" \
  "$PYTHON_BIN" -m pc_side.globalcam_yolo_result_node "$@"
