#!/usr/bin/env bash
set -eo pipefail

source /opt/ros/jazzy/setup.bash
set -u
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-4}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

exec ros2 launch "$PROJECT_DIR/launch/globalcam_object_map.launch.py" \
  perspective_calibration_mode:=true \
  perspective_preview:=true \
  "$@"
